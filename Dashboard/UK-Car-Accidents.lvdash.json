{
  "datasets": [
    {
      "name": "8ead210e",
      "displayName": "accidents",
      "queryLines": [
        "SELECT * FROM road_safety.v_accidents"
      ]
    },
    {
      "name": "6aead587",
      "displayName": "kpi_fatal_share",
      "queryLines": [
        "SELECT ROUND(100.0 * SUM(CASE WHEN severity='Fatal' THEN 1 ELSE 0 END) / COUNT(*), 2) AS fatal_pct FROM road_safety.v_accidents"
      ]
    },
    {
      "name": "e5c792c6",
      "displayName": "light_by_area",
      "queryLines": [
        "SELECT light_conditions, urban_rural,\n",
        "       COUNT(*) AS accidents,\n",
        "       ROUND(100.0 * SUM(CASE WHEN severity IN ('Fatal','Serious') THEN 1 ELSE 0 END) / COUNT(*), 2) AS fatal_or_serious_pct\n",
        "FROM road_safety.v_accidents\n",
        "WHERE light_conditions <> 'Data missing or out of range'\n",
        "  AND urban_rural <> 'Unallocated'\n",
        "GROUP BY light_conditions, urban_rural\n",
        "ORDER BY fatal_or_serious_pct DESC"
      ]
    },
    {
      "name": "b364753c",
      "displayName": "day_hour",
      "queryLines": [
        "SELECT dayofweek(accident_date) AS day_num, day_of_week, accident_hour, COUNT(*) AS accidents\r\n",
        "FROM road_safety.v_accidents\r\n",
        "WHERE accident_hour IS NOT NULL\r\n",
        "GROUP BY dayofweek(accident_date), day_of_week, accident_hour"
      ]
    },
    {
      "name": "9bf781ee",
      "displayName": "force_ranking",
      "queryLines": [
        "WITH force_stats AS (\r\n",
        "  SELECT police_force,\r\n",
        "         COUNT(*) AS accidents,\r\n",
        "         SUM(CASE WHEN severity = 'Fatal' THEN 1 ELSE 0 END) AS fatal\r\n",
        "  FROM road_safety.v_accidents\r\n",
        "  GROUP BY police_force\r\n",
        ")\r\n",
        "SELECT police_force, accidents, fatal,\r\n",
        "       ROUND(100.0 * fatal / accidents, 2) AS fatal_pct,\r\n",
        "       RANK() OVER (ORDER BY 1.0 * fatal / accidents DESC) AS fatal_rank\r\n",
        "FROM force_stats\r\n",
        "WHERE accidents >= 10000\r\n",
        "ORDER BY fatal_rank"
      ]
    },
    {
      "name": "cab8e2e5",
      "displayName": "casualty_age",
      "queryLines": [
        "SELECT c.Age_Band_of_Casualty AS band_code, ab.label AS age_band, cc.label AS casualty_class,\r\n",
        "       COUNT(*) AS casualties,\r\n",
        "       ROUND(100.0 * SUM(CASE WHEN c.Casualty_Severity IN (1,2) THEN 1 ELSE 0 END) / COUNT(*), 2) AS fatal_or_serious_pct\r\n",
        "FROM road_safety.casualties_raw c\r\n",
        "LEFT JOIN road_safety.age_band ab       ON c.Age_Band_of_Casualty = ab.code\r\n",
        "LEFT JOIN road_safety.casualty_class cc ON c.Casualty_Class = cc.code\r\n",
        "GROUP BY c.Age_Band_of_Casualty, ab.label, cc.label"
      ]
    },
    {
      "name": "fatal_by_region_top5",
      "displayName": "fatal_by_region_top5",
      "config": {
        "version": "1.1",
        "source": "SELECT `local_authority` AS region,\n       COUNT_IF(`severity` = 'Fatal') AS fatal_crashes,\n       ROUND(AVG(`Latitude`), 4) AS latitude,\n       ROUND(AVG(`Longitude`), 4) AS longitude\nFROM road_safety.v_accidents WHERE `Latitude` IS NOT NULL AND `Longitude` IS NOT NULL GROUP BY `local_authority` ORDER BY fatal_crashes DESC LIMIT 5",
        "dimensions": [
          {
            "name": "region",
            "expr": "region",
            "comment": "Local authority with the most fatal crashes"
          },
          {
            "name": "fatal_crashes",
            "expr": "fatal_crashes",
            "comment": "Number of fatal accidents in the region (2005-2015)"
          },
          {
            "name": "latitude",
            "expr": "latitude",
            "comment": "Average accident latitude in the region (WGS84)"
          },
          {
            "name": "longitude",
            "expr": "longitude",
            "comment": "Average accident longitude in the region (WGS84)"
          }
        ],
        "comment": "Top 5 UK local authorities by fatal crash count, with accident centroids"
      }
    },
    {
      "name": "fatal_by_region",
      "displayName": "fatal_by_region",
      "config": {
        "version": "1.1",
        "source": "SELECT `local_authority` AS region,\n       COUNT_IF(`severity` = 'Fatal') AS fatal_crashes,\n       ROUND(AVG(`Latitude`), 4) AS latitude,\n       ROUND(AVG(`Longitude`), 4) AS longitude\nFROM road_safety.v_accidents WHERE `Latitude` IS NOT NULL AND `Longitude` IS NOT NULL GROUP BY `local_authority` ORDER BY fatal_crashes DESC",
        "dimensions": [
          {
            "name": "region",
            "expr": "region",
            "comment": "Local authority"
          },
          {
            "name": "fatal_crashes",
            "expr": "fatal_crashes",
            "comment": "Number of fatal accidents in the region (2005-2015)"
          },
          {
            "name": "latitude",
            "expr": "latitude",
            "comment": "Average accident latitude in the region (WGS84)"
          },
          {
            "name": "longitude",
            "expr": "longitude",
            "comment": "Average accident longitude in the region (WGS84)"
          }
        ],
        "comment": "All UK local authorities by fatal crash count, with accident centroids"
      }
    },
    {
      "name": "d188cd29",
      "displayName": "fatal_share_map",
      "queryLines": [
        "SELECT local_authority,\r\n",
        "       AVG(Latitude)  AS lat,\r\n",
        "       AVG(Longitude) AS lon,\r\n",
        "       COUNT(*)       AS collisions,\r\n",
        "       SUM(CASE WHEN severity = 'Fatal' THEN 1 ELSE 0 END) AS fatal,\r\n",
        "       ROUND(100.0 * SUM(CASE WHEN severity = 'Fatal' THEN 1 ELSE 0 END) / COUNT(*), 2) AS fatal_pct\r\n",
        "FROM road_safety.v_accidents\r\n",
        "WHERE Latitude IS NOT NULL AND Longitude IS NOT NULL\r\n",
        "GROUP BY local_authority\r\n",
        "HAVING COUNT(*) >= 2000\r\n",
        "ORDER BY fatal_pct DESC"
      ]
    }
  ],
